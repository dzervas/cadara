{
  "name": "cadara",
  "compatibility_date": "2026-04-19",
  "build": {
    "command": "bun run build",
    "watch_dir": [
      "src",
      "landing",
      "public",
      "index.html",
      "app.html",
      "404.html",
      "vite.config.ts",
    ],
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
